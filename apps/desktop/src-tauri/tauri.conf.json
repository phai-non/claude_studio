{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Studio",
  "version": "1.0.0",
  "identifier": "com.claudestudio.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzNzJBQkUyN0QwM0Q4ODIKUldTQzJBTjk0cXR5NHhoZkxQTE1rRnRNYTd0TDB3YWZWei83eGNtL1RCSm9aeWk0aUUxV3RVUGUK",
      "endpoints": [
        "https://github.com/UkiDelly/claude_studio/releases/latest/download/latest.json"
      ]
    }
  }
}
